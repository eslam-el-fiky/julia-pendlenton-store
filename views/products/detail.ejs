<%- include('../partials/head', { pageTitle }) %><%- include('../partials/header') %>
<main class="page-wrap">
  <div class="breadcrumbs"><a href="/">Home</a> / <a href="/shop">Shop</a> / <%= product.title %></div>
  <section class="product-detail"><div class="detail-image"><img src="<%= product.image %>" alt="<%= product.title %>"></div><div class="detail-copy"><p class="eyebrow"><%= product.category %></p><h1><%= product.title %></h1><p class="detail-price"><%= product.price.toLocaleString('en-US') %> KWD</p><p><%= product.description %></p><div class="detail-meta"><span>Weight</span><strong><%= product.weight %></strong><span>Availability</span><strong><%= product.stock > 0 ? 'In stock' : 'Sold out' %></strong></div><% if (product.stock > 0) { %><form action="/cart/add" method="POST" class="buy-form"><input type="hidden" name="productId" value="<%= product._id %>"><label for="quantity">Quantity</label><input id="quantity" type="number" name="quantity" min="1" max="<%= Math.min(product.stock, 10) %>" value="1"><button class="button button-dark" type="submit">Add to bag — <%= product.price.toLocaleString('en-US') %> KWD</button></form><% } else { %><button class="button button-dark" disabled>Currently unavailable</button><% } %><p class="muted small">Shipping calculated at checkout. Delivery availability may vary by area.</p></div></section>
  <% if (related.length) { %><section class="section"><div class="section-heading"><h2>You may also love</h2><a class="text-link" href="/shop">Shop all ↗</a></div><div class="product-grid"><% related.forEach(product => { %><%- include('../partials/product-card', { product }) %><% }) %></div></section><% } %>
</main><%- include('../partials/footer') %>
