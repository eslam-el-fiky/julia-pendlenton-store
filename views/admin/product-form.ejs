<%- include('../partials/head', { pageTitle }) %><%- include('../partials/header') %><main class="admin-wrap"><aside class="admin-sidebar"><p class="eyebrow">Julia Pendlenton Store MANAGEMENT</p><a href="/admin">Overview</a><a class="active" href="/admin/products">Products</a><a href="/admin/orders">Orders</a></aside><section class="admin-content"><div class="admin-heading"><div><p class="eyebrow">COLLECTION MANAGEMENT</p><h1><%= product ? 'Edit' : 'Add' %> <em>product.</em></h1></div><a class="text-link" href="/admin/products">← Back to products</a></div><form class="admin-form admin-panel" action="<%= product ? '/admin/products/' + product._id + '/edit' : '/admin/products' %>" method="POST"><div class="form-grid"><label>Product name *<input name="title" required value="<%= product?.title || '' %>"></label><label>Slug (URL) *<input name="slug" required value="<%= product?.slug || '' %>" placeholder="rose-oud"></label><label>Price (EGP) *<input type="number" name="price" min="0" step="0.01" required value="<%= product?.price ?? '' %>"></label><label>Stock quantity *<input type="number" name="stock" min="0" step="1" required value="<%= product?.stock ?? 0 %>"></label><label>Category *<input name="category" required value="<%= product?.category || 'Signature Soaps' %>"></label><label>Weight / size<input name="weight" value="<%= product?.weight || '100 g' %>"></label><label class="full-span">Image path<input name="image" value="<%= product?.image || '/images/soap-rose.svg' %>" required><small>Use a path in /public or a trusted image URL.</small></label><label class="full-span">Description<textarea name="description" rows="4" required><%= product?.description || '' %></textarea></label><label class="check-label"><input type="checkbox" name="featured" <%= product?.featured ? 'checked' : '' %>> Feature on homepage</label></div><button class="button button-dark" type="submit"><%= product ? 'Save changes' : 'Create product' %></button></form></section></main><%- include('../partials/footer') %>
