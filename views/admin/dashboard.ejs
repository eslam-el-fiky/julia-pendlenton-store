<%- include('../partials/head', { pageTitle }) %><%- include('../partials/header') %><main class="admin-wrap"><aside class="admin-sidebar"><p class="eyebrow">Julia Pendlenton Store MANAGEMENT</p><a class="active" href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/orders">Orders</a><form action="/auth/logout" method="POST"><button class="sidebar-logout">Sign out</button></form></aside><section class="admin-content"><div class="admin-heading"><div><p class="eyebrow">STORE OVERVIEW</p><h1>Good things are <em>happening.</em></h1></div><a class="button button-dark" href="/admin/products/new">+ Add product</a></div><div class="stats-grid"><article class="stat-card"><span>Active products</span><strong><%= productCount %></strong></article><article class="stat-card"><span>Total orders</span><strong><%= ordersCount %></strong></article><article class="stat-card"><span>Order value (non-cancelled)</span><strong><%= revenue.toLocaleString('en-US') %> KWD</strong></article></div><div class="admin-panel"><div class="section-heading"><h2>Latest orders</h2><a class="text-link" href="/admin/orders">View all ↗</a></div><% if (!newOrders.length) { %><p class="muted">No new orders right now.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead><tbody><% newOrders.forEach(order => { %><tr><td><%= order.orderNumber %></td><td><%= order.customer.name %></td><td><%= order.total.toLocaleString('en-US') %> KWD</td><td><span class="status"><%= order.status %></span></td></tr><% }) %></tbody></table></div><% } %></div><div class="admin-panel"><h2>Low stock</h2><% if (!lowStock.length) { %><p class="muted">No low-stock alerts.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Product</th><th>Available</th></tr></thead><tbody><% lowStock.forEach(p => { %><tr><td><%= p.title %></td><td><span class="stock-warning"><%= p.stock %> left</span></td></tr><% }) %></tbody></table></div><% } %></div></section></main><%- include('../partials/footer') %>
