<%- include('../partials/head', { pageTitle }) %><%- include('../partials/header') %><main class="admin-wrap"><aside class="admin-sidebar"><p class="eyebrow">Julia Pendlenton Store MANAGEMENT</p><a href="/admin">Overview</a><a class="active" href="/admin/products">Products</a><a href="/admin/orders">Orders</a><form action="/auth/logout" method="POST"><button class="sidebar-logout">Sign out</button></form></aside><section class="admin-content"><div class="admin-heading"><div><p class="eyebrow">YOUR COLLECTION</p><h1>Manage <em>products.</em></h1></div><a class="button button-dark" href="/admin/products/new">+ Add product</a></div><div class="table-wrap admin-panel"><table><thead><tr><th>Product</th><th>Price</th><th>Stock</th><th>Visibility</th><th>Actions</th></tr></thead><tbody><% products.forEach(product => { %><tr><td><div class="admin-product"><img src="<%= product.image %>" alt=""><span><strong><%= product.title %></strong><small><%= product.slug %></small></span></div></td><td><%= product.price.toLocaleString('en-US') %> KWD</td><td><%= product.stock %></td><td><%= product.isActive ? 'Visible' : 'Hidden' %></td><td><div class="table-actions"><a href="/admin/products/<%= product._id %>/edit">Edit</a><form action="/admin/products/<%= product._id %>/delete" method="POST" onsubmit="return confirm('Hide this product from the store?')"><button>Hide</button></form></div></td></tr><% }) %></tbody></table></div></section></main><%- include('../partials/footer') %>
