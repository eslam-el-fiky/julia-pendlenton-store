<%- include('../partials/head', { pageTitle }) %><%- include('../partials/header') %><main class="admin-wrap"><aside class="admin-sidebar"><p class="eyebrow">Julia Pendlenton Store MANAGEMENT</p><a href="/admin">Overview</a><a href="/admin/products">Products</a><a class="active" href="/admin/orders">Orders</a><form action="/auth/logout" method="POST"><button class="sidebar-logout">Sign out</button></form></aside><section class="admin-content"><div class="admin-heading"><div><p class="eyebrow">FULFILMENT</p><h1>Manage <em>orders.</em></h1></div></div><div class="table-wrap admin-panel"><table><thead><tr><th>Order / Date</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody><% orders.forEach(order => { %><tr><td><strong><%= order.orderNumber %></strong><small class="table-sub"><%= order.createdAt.toLocaleDateString() %></small></td><td><strong><%= order.customer.name %></strong><small class="table-sub"><%= order.customer.phone %></small><small class="table-sub"><%= order.customer.city %></small></td><td><%= order.items.reduce((sum, item) => sum + item.quantity, 0) %></td><td><%= order.total.toLocaleString('en-US') %> KWD</td><td><span class="status"><%= order.status %></span></td><td><form action="/admin/orders/<%= order._id %>/status" method="POST" class="status-form"><select name="status"><% ['new','confirmed','preparing','shipped','delivered','cancelled'].forEach(status => { %><option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="small-button">Save</button></form></td></tr><% }) %></tbody></table></div></section></main><%- include('../partials/footer') %>
