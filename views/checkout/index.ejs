<%- include('../partials/head', { pageTitle }) %><%- include('../partials/header') %>
<main class="page-wrap narrow-wrap"><div class="page-intro align-left"><p class="eyebrow">ALMOST YOURS</p><h1>Complete your <em>order.</em></h1></div>
<% if (!items.length) { %><div class="empty-state"><h2>Your bag is empty</h2><a class="button button-dark" href="/shop">Shop the collection</a></div><% } else { %>
<div class="checkout-layout"><form class="checkout-form" action="/checkout/whatsapp" method="POST"><h2>Delivery details</h2><label>Full name *<input name="name" required value="<%= currentUser ? currentUser.name : '' %>"></label><label>Email<input type="email" name="email" value="<%= currentUser ? currentUser.email : '' %>"></label><label>Phone number *<input name="phone" type="tel" required autocomplete="tel"></label><label>City / Area *<input name="city" required></label><label>Full address *<textarea name="address" rows="3" required></textarea></label><label>Gift message (optional)<textarea name="giftMessage" rows="3" maxlength="500" placeholder="Write a little note..."></textarea></label><h2>Order confirmation</h2><div class="payment-option"><span>Confirm on WhatsApp</span><span>Your order details will open in a WhatsApp chat.</span></div><button class="button button-dark full-width" type="submit">Continue to WhatsApp · <%= subtotal.toLocaleString('en-US') %> KWD</button><p class="muted small">Please check your details. You will review and send the order in WhatsApp.</p></form><aside class="order-summary"><h2>Your order</h2><% items.forEach(item => { %><div class="checkout-item"><img src="<%= item.product.image %>" alt=""><span><%= item.product.title %> × <%= item.quantity %></span><strong><%= item.lineTotal.toLocaleString('en-US') %> KWD</strong></div><% }) %><div><span>Subtotal</span><strong><%= subtotal.toLocaleString('en-US') %> KWD</strong></div><div class="summary-total"><span>Total</span><strong><%= subtotal.toLocaleString('en-US') %> KWD</strong></div></aside></div><% } %>
</main><%- include('../partials/footer') %>
