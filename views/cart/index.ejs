<%- include('../partials/head', { pageTitle }) %><%- include('../partials/header') %>
<main class="page-wrap narrow-wrap"><div class="page-intro align-left"><p class="eyebrow">YOUR SELECTION</p><h1>Your <em>bag.</em></h1><p>Beautiful things, thoughtfully chosen.</p></div>
<% if (!items.length) { %><div class="empty-state"><div class="empty-icon">✧</div><h2>Your bag is waiting</h2><p>Discover something special to make someone's day.</p><a class="button button-dark" href="/shop">Explore the collection</a></div><% } else { %>
<div class="cart-layout"><div class="cart-items"><% items.forEach(item => { %><article class="cart-item"><img src="<%= item.product.image %>" alt=""><div class="cart-item-info"><a href="/products/<%= item.product.slug %>"><strong><%= item.product.title %></strong></a><p><%= item.product.price.toLocaleString('en-US') %> KWD</p><form action="/cart/update" method="POST" class="quantity-form"><input type="hidden" name="productId" value="<%= item.product._id %>"><input type="number" name="quantity" min="1" max="<%= Math.min(item.product.stock, 10) %>" value="<%= item.quantity %>"><button type="submit" class="text-link">Update</button></form><form action="/cart/remove" method="POST"><input type="hidden" name="productId" value="<%= item.product._id %>"><button class="remove-link" type="submit">Remove</button></form></div><strong><%= item.lineTotal.toLocaleString('en-US') %> KWD</strong></article><% }) %></div>
<aside class="order-summary"><h2>Order summary</h2><div><span>Subtotal</span><strong><%= subtotal.toLocaleString('en-US') %> KWD</strong></div><div class="summary-total"><span>Total</span><strong><%= subtotal.toLocaleString('en-US') %> KWD</strong></div><a class="button button-dark full-width" href="/checkout">Continue to checkout</a><a class="continue-link" href="/shop">← Continue shopping</a></aside></div><% } %>
</main><%- include('../partials/footer') %>
